<idea-plugin>
    <id>io.github.askmeagain.projecttabbar</id>
    <name>Project Tab Bar</name>
    <version>0.0.1</version>
    <vendor>AskMeAgain</vendor>

    <description>Switch between open IntelliJ IDEA project windows using a shared tab strip at the top of every window.</description>

    <idea-version since-build="261"/>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="project-tab-bar-git.xml">Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="io.github.askmeagain.projecttabbar.ProjectTabBarSettings"/>
        <applicationConfigurable parentId="tools" id="io.github.askmeagain.projecttabbar.settings"
                                 displayName="Project Tab Bar"
                                 instance="io.github.askmeagain.projecttabbar.ProjectTabBarConfigurable"/>
    </extensions>

    <actions>
        <action id="ProjectTabBar.ProjectWindows" class="io.github.askmeagain.projecttabbar.ProjectTabBarAction" text="Project Tab Bar">
            <add-to-group group-id="MainToolbarCenter" anchor="first"/>
        </action>
    </actions>

</idea-plugin>
