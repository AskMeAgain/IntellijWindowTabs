<idea-plugin>
    <id>com.intellijwindowtabs</id>
    <name>Window Tabs</name>
    <version>0.0.1</version>
    <vendor>Window Tabs</vendor>

    <description>Switch between open IntelliJ IDEA project windows using a shared tab strip at the top of every window.</description>

    <idea-version since-build="243"/>

    <depends>com.intellij.modules.platform</depends>
    <actions>
        <action id="WindowTabs.ProjectWindows" class="com.intellijwindowtabs.WindowTabsAction" text="Project Window Tabs">
            <add-to-group group-id="MainToolbarCenter" anchor="first"/>
        </action>
    </actions>

</idea-plugin>
